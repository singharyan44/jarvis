# ===== REQUIRED for AI features =====
# OpenRouter API key for AI intent classification (Phase 5)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ===== REQUIRED for ElevenLabs TTS =====
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional ElevenLabs settings
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=pcm_24000

# ===== OPTIONAL: Vosk Offline STT =====
# Download model from: https://alphacephei.com/vosk/models
VOSK_MODEL_PATH=

# ===== OPTIONAL: Local LLM (Offline Mode) =====
# Ollama (http://localhost:11434) - install from ollama.ai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# LM Studio (http://localhost:1234)
LM_STUDIO_BASE_URL=http://localhost:1234
LM_STUDIO_MODEL=

# ===== OPTIONAL: Honcho Memory =====
HONCHO_API_URL=http://localhost:8000

# ===== OPTIONAL: Offline Mode =====
JARVIS_OFFLINE_MODE=false

# ===== OPTIONAL: Whisper =====
# Device: auto (tries CUDA then CPU), cuda, cpu
WHISPER_DEVICE=auto
# Model: tiny, base, small, medium, large, large-v2, large-v3, distil-*
WHISPER_MODEL_SIZE=small
# Compute type: auto, default, int8, int8_float16, float16, float32
# Use int8 for faster CPU inference, float16 for GPU
WHISPER_COMPUTE_TYPE=default

# ===== OPTIONAL: Wake Word =====
WAKE_WORD_ENABLED=true
WAKE_WORD_PHRASES=hey jarvis,jarvis
WAKE_WORD_SENSITIVITY=0.5
WAKE_WORD_COOLDOWN=2.0

# ===== OPTIONAL: Welcome TTS Caching =====
JARVIS_WELCOME_CACHE_ENABLED=true